{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "maxiidevgd.maxi-menu",
	"name": "Maxi Menu",
	"version": "v1.2.0",
	"developer": "maxiidevgd",
	"description": "Menu de hacks para practicar.",
	"tags": ["cheat"],
	"settings": {
		"noclip": {
			"type": "bool",
			"default": false,
			"name": "Noclip",
			"description": "No mueres al tocar obstaculos."
		},
		"noclip-spikes": {
			"type": "bool",
			"default": false,
			"name": "Noclip solo picos",
			"description": "Los picos no te matan, los bloques si."
		},
		"noclip-blocks": {
			"type": "bool",
			"default": false,
			"name": "Noclip solo bloques",
			"description": "Los bloques no te matan, los picos si."
		},
		"speed": {
			"type": "float",
			"default": 1.0,
			"min": 0.1,
			"max": 3.0,
			"name": "Speedhack",
			"description": "Velocidad del juego dentro de niveles. 1.0 es normal."
		},
		"speed-practice-only": {
			"type": "bool",
			"default": false,
			"name": "Speedhack solo en practica"
		},
		"hitboxes": {
			"type": "bool",
			"default": false,
			"name": "Mostrar hitboxes"
		},
		"instant-respawn": {
			"type": "bool",
			"default": false,
			"name": "Respawn instantaneo"
		},
		"no-death-effect": {
			"type": "bool",
			"default": false,
			"name": "Sin efecto de muerte"
		},
		"jump-hack": {
			"type": "bool",
			"default": false,
			"name": "Jump hack",
			"description": "Puedes saltar en el aire."
		},
		"unlock-icons": {
			"type": "bool",
			"default": false,
			"name": "Desbloquear iconos y colores",
			"description": "Muestra todo como desbloqueado."
		},
		"force-practice": {
			"type": "bool",
			"default": false,
			"name": "Forzar modo practica"
		},
		"autoclick": {
			"type": "bool",
			"default": false,
			"name": "Autoclick"
		},
		"cps": {
			"type": "int",
			"default": 10,
			"min": 1,
			"max": 30,
			"name": "CPS del autoclick"
		},
		"auto-hold": {
			"type": "bool",
			"default": false,
			"name": "Mantener click automatico",
			"description": "Mantiene el click apretado desde que empieza el intento."
		},
		"hide-p2": {
			"type": "bool",
			"default": false,
			"name": "Ocultar jugador 2"
		},
		"player-opacity": {
			"type": "int",
			"default": 255,
			"min": 0,
			"max": 255,
			"name": "Opacidad del jugador",
			"description": "255 es normal, 0 es invisible."
		},
		"counter": {
			"type": "bool",
			"default": false,
			"name": "Contador en pantalla",
			"description": "Muestra intento, tiempo y muertes evitadas."
		},
		"watermark": {
			"type": "bool",
			"default": true,
			"name": "Marca de trucos activos"
		},
		"mute-music": {
			"type": "bool",
			"default": false,
			"name": "Silenciar musica"
		},
		"restart-at": {
			"type": "int",
			"default": 0,
			"min": 0,
			"max": 100,
			"name": "Reiniciar al X%",
			"description": "0 lo desactiva."
		},
		"safe-mode": {
			"type": "bool",
			"default": true,
			"name": "Modo seguro",
			"description": "Si usas trucos, el nivel completado no guarda progreso."
		}
	},
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	}
}
